@import './../../design/styles/common/global.styl'

:root {
  --series-count-background-color: #678696;
  --active-color: #20A5D6;
}

.thumbnail.active
  .alt-image-text
    border-color: var(--active-color);
    box-shadow: none
    transition: var(--sidebar-transition);

.thumbnail
  cursor: pointer
  display: table
  margin: 0 auto;
  min-width: 90%;
  padding-bottom: 1.5rem;

  .alt-image-text
    align-items: center;
    justify-content: center;
    background-color: var(--primary-background-color);
    box-shadow: inset 0 0 0 1px var(--ui-border-color-dark);
    border: 2px solid transparent;
    border-radius: 12px;
    min-height: 135px;
    max-height: 250px;
    margin: 0 auto;
    padding: 5px;
    position: relative;
    transition: var(--sidebar-transition);
    width: 217px;
    display: flex;

    h1
      text-align: center
      color: var(--text-primary-color);
      max-width: 200px;
      max-height: 250px;
      overflow-wrap: break-word;
      word-wrap: break-word;
      hyphens: auto;

  .series-details
    display: flex;
    flex-direction: column
    color: var(--text-primary-color);
    font-size: 14px
    line-height: 1.3em
    // Matches the description-to-status-row gap below (`.series-information`), so the preview,
    // the description, and the indicator row are evenly separated rather than the description
    // sitting tight under the preview.
    margin-top: 7px
    margin-left: 1rem
    margin-right: 0.5rem
    max-width: 217px
    position: relative
    word-wrap: break-word

    .series-description
      flex-grow: 1

    &.info-only .series-description
      display: none

  .series-information
    // One row, everything on a shared vertical centreline. `align-items: center` is what actually
    // lines the indicators up: without it flex stretches each item to the row height and every
    // glyph sits wherever its own box happens to put it.
    display: flex
    flex-direction: row
    align-items: center
    justify-content: space-between
    // Discernible separation from the series description above.
    margin-top: 7px
    min-height: 18px
    gap: 8px

    .series-information-left,
    .series-information-right
      display: flex
      flex-direction: row
      align-items: center
      // Spacing between adjacent indicators, so nothing needs its own bespoke margin.
      gap: 8px

    .series-information-left
      // May ellipsis; must not push the controls off the row.
      min-width: 0
      overflow: hidden

    .series-information-right
      // Never compresses -- the actions button and the status glyphs keep their size and the
      // left group gives way instead.
      flex: 0 0 auto
      margin-left: auto

    .item-series
      display: flex
      flex-direction: row
      align-items: center
      min-width: 0

    .item-frames .icon
      height: 18px

    .item-series.image-frames .icon
        background-color: var(--series-count-background-color);
        position: relative

        &:after
          content: ''
          background-color: var(--active-color);
          box-shadow: 1px 1px rgba(0, 0, 0, .115)
          left: -4px
          position: absolute
          top: -4px

        &
        &:after
          content: ''
          border: 0px solid var(--series-count-background-color)
          display: inline-block
          height: 11px
          width: 11px

    .item-series.image-frames
      // Clearance from the series number. The stacked-squares glyph hangs 4px up and LEFT of its
      // own box (the :after above), so 4px of any gap is eaten before it reads as space: this is
      // the row `gap` (8px) + 8px - the 4px overhang = 12px of visible separation.
      margin-left: 8px

    .warning
      display: flex
      align-items: center
      opacity: 1
      color: #e29e4a;

      svg
        width: 16px;
        height: 14px;
        display: block
        pointer-events: inherit;

    // Derived-resource link: this series has an associated DICOM-SEG or DICOM-SR.
    .derived
      display: flex
      align-items: center
      // On top of the row `gap`, so the link stands apart from the warning glyph on one side and
      // the actions button on the other rather than reading as one run of icons: 8px + 5px = 13px
      // of separation each way.
      margin-left: 5px
      margin-right: 5px
      color: var(--active-color, #20a5d6);

      svg
        width: 14px;
        height: 14px;
        display: block

    // Offline-cache availability indicator (ohif-viewers#125, FR-8)
    .cache-indicator
      display: flex
      align-items: center
      opacity: 1
      color: var(--active-color, #20a5d6);

      svg
        width: 16px;
        height: 16px;
        display: block
        pointer-events: inherit;


    .value
      color: var(--text-secondary-color);
      display: inline-block
      font-size: 12px
      line-height: 1
      margin-left: 4px
      overflow: hidden
      text-overflow: ellipsis
      white-space: nowrap
      // NOT `width: calc(100% - 15px)`. A percentage width on a flex item resolves against the
      // whole row, so each indicator claimed nearly the full width and they rendered on top of
      // one another. These are short numbers -- size to content and cap it.
      max-width: 72px

    .icon
      color: var(--active-color);
      display: inline-block
      flex: 0 0 auto
      font-size: 10px
      font-weight: 900
      line-height: 1
      text-align: right
      width: 11px
