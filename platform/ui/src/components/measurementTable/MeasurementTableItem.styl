.measurementItem
  .item-color-section
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;

 .item-color
    margin-top: 8px;
    border-radius: 100%;
    width: 20px;
    height: 20px;

  .rowActions
    display: flex
    justify-content: space-between
    align-items: center
    width: auto;
    margin-top: 5px;
    margin-left: -6px;
    padding-left: 3px;
    padding-right: 10px;      
    background-color: var(--ui-gray-darker)
    height: 0
    overflow: hidden
    transition: all 0.3s ease
    visibility: hidden

    .btnAction
      background-color: transparent;
      border: none;
      color: var(--default-color)
      cursor: pointer
      line-height: 35px
      height: 35px
      transition: all 0.3s ease
      white-space: no-wrap

      &:hover, &:active
        color: var(--text-primary-color)

      i
        margin-right: 4px;

  &.selected
    .rowActions
      height: auto;
      visibility: visible

  .measurementContent
    display: flex
    justify-content: space-between;
    width: auto;
    max-width: calc(100% - 10px);

  // The row controls as the Segmentations panel's rows lay them out (ui-next DataRow at the panel's
  // 0.3rem spacing): the visibility toggle and a lock slot, each 1.8rem, 0.3rem apart. As there,
  // the toggle shows while the row is hovered or selected, or while the measurement is hidden; the
  // lock is in the muted foreground colour
  .measurementStatus
    display: flex
    flex: 0 0 auto
    align-items: center
    column-gap: 0.3rem
    align-self: flex-start
    // Centred on the first text line (1.5rem), as DataRow centres its icons on its label
    margin-top: calc((1.5rem - 1.8rem) / 2)

    .annotationVisibilityToggle
      opacity: 0

  .measurementLockSlot
    display: inline-flex
    align-items: center
    justify-content: center
    width: 1.8rem
    height: 1.8rem
    color: unquote('hsl(var(--muted-foreground))')

    svg
      width: 1.8rem
      height: 1.8rem
      // The lock's body sits low in its viewBox; raised so it reads level with the eye
      position: relative
      top: -2px

  // Written in full: the indentation of .item-color above ends the .measurementItem block
  .measurementItem:hover .measurementStatus .annotationVisibilityToggle,
  .measurementItem.selected .measurementStatus .annotationVisibilityToggle
    opacity: 1

  .measurementStatus .annotationVisibilityToggle:focus-visible,
  .measurementStatus .annotationVisibilityToggle.isHidden
    opacity: 1

  // The row's text as the Segmentations panel's segment labels (DataRow text-base in the panel
  // theme): Inter, 1rem on a 1.5rem line
  .measurementItem .displayTexts,
  .measurementItem .measurementLabel
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif
    font-size: 1rem
    line-height: 1.5rem
    font-weight: 400

  // The value line sits closer to the top of the row than the table list's default 9px
  .tableListItem.measurementItem .itemContent
    margin-top: 5px

  // The location and description line is secondary to the value line above it
  .measurementItem .measurementLabel
    font-size: 0.9rem

  .measurementLabel
    margin-top: 0px;
    padding-left: 4px;
    padding-right: 10px;
    padding-bottom: 1px;
    overflow: hidden;
    text-overflow: ellipsis;
    overflow-wrap: normal;
    white-space: nowrap;

  .measurementDisplayText
    display: inline-block;
    padding-left: 9px;
    margin-left: -7px;
    border-left: 1px solid var(--text-secondary-color);
    color: var(--text-primary-color);

  .seriesTagMeaning
    margin-left: 10px;

  .itemIndex
    -webkit-box-sizing: initial;
    -moz-box-sizing: initial;
    box-sizing: initial;

  &.hasWarnings
    .itemIndex
      opacity: 1
      background-color: #e29e4a;
      color: #fff;

    .warning-icon
      display: block;
      margin: 7px auto 0;

      svg
        width: 22px;
        height: 20px;
        pointer-events: inherit;

.icons
  display: flex;
  align-items: center;
  border-radius: 5px;

.icons .eye-icon
  margin-left: 100px;
  margin-right: -5px;
.icons .angle-double-down
.icons .angle-double-up
  margin-left: 15px;
  margin-right: -5px;

.referenceMeta
  display: flex;
  align-items: center;
  column-gap: 10px;
  margin: 1px 0 0 4px;
  color: var(--text-secondary-color);

  // Matches the thumbnail's series/image indicators
  .refItem
    display: inline-flex;
    align-items: center;

  .refLabel
    font-size: 10px;
    font-weight: 900;
    line-height: 1;

  .refValue
    font-size: 12px;
    line-height: 1;
    margin-left: 4px;

&.active
  .referenceMeta
    color: var(--active-color);

.measurementLabelTooltip
  max-width: 320px;
  white-space: normal;
  overflow-wrap: anywhere;
