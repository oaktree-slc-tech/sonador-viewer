.measurementItem
  .item-color-section
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;

 .item-color
    margin-top: 8px;
    border-radius: 100%;
    width: 20px;
    height: 20px;

  .rowActions
    display: flex
    justify-content: space-between
    align-items: center
    width: auto;
    margin-top: 5px;
    margin-left: -6px;
    padding-left: 3px;
    padding-right: 10px;      
    background-color: var(--ui-gray-darker)
    height: 0
    overflow: hidden
    transition: all 0.3s ease
    visibility: hidden

    .btnAction
      background-color: transparent;
      border: none;
      color: var(--default-color)
      cursor: pointer
      line-height: 35px
      height: 35px
      transition: all 0.3s ease
      white-space: no-wrap

      &:hover, &:active
        color: var(--text-primary-color)

      i
        margin-right: 4px;

  &.selected
    .rowActions
      height: auto;
      visibility: visible

  .measurementContent
    display: flex
    justify-content: space-between;
    width: auto;
    max-width: calc(100% - 10px);

  // The row controls as the Segmentations panel's rows lay them out (ui-next DataRow at the panel's
  // 0.3rem spacing), packed to the right: the visibility toggle, the lock while locked, and the
  // actions menu of a pending measurement, each 1.8rem, 0.3rem apart. A lock or a menu moves the
  // toggle left, as in a segment row. As there, the toggle shows while the row is hovered or
  // selected, or while the measurement is hidden, and the menu while the row is hovered or
  // selected, or it is open; the lock is in the muted foreground colour.
  .measurementStatus
    display: flex
    flex: 0 0 auto
    align-items: center
    column-gap: 0.3rem
    align-self: flex-start
    // Centred on the first text line (1.5rem), as DataRow centres its icons on its label
    margin-top: calc((1.5rem - 1.8rem) / 2)
    // The Segmentations panel's row spacing, so the ui-next h-6/w-6 sizes (the actions button and
    // its icon) are 1.8rem, as there
    --spacing: 0.3rem

    .annotationVisibilityToggle
      opacity: 0

  .measurementActions
    flex: 0 0 auto

  .measurementControlSpacer
    flex: 0 0 auto
    width: 1.8rem
    height: 1.8rem

  .measurementLock
    display: inline-flex
    align-items: center
    justify-content: center
    width: 1.8rem
    height: 1.8rem
    color: unquote('hsl(var(--muted-foreground))')

    svg
      width: 1.8rem
      height: 1.8rem
      // The lock's body sits low in its viewBox; raised so it reads level with the eye
      position: relative
      top: -2px

  // Written in full: the indentation of .item-color above ends the .measurementItem block
  .measurementItem:hover .measurementStatus .annotationVisibilityToggle,
  .measurementItem.selected .measurementStatus .annotationVisibilityToggle
    opacity: 1

  .measurementStatus .annotationVisibilityToggle:focus-visible,
  .measurementStatus .annotationVisibilityToggle.isHidden
    opacity: 1

  // The row's text as the Segmentations panel's segment labels (DataRow text-base in the panel
  // theme): Inter, 1rem on a 1.5rem line
  .measurementItem .displayTexts,
  .measurementItem .measurementLabel
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif
    font-size: 1rem
    line-height: 1.5rem
    font-weight: 400

  // The value line sits closer to the top of the row than the table list's default 9px
  .tableListItem.measurementItem .itemContent
    margin-top: 5px

  // The location and description line is secondary to the value line above it
  .measurementItem .measurementLabel
    font-size: 0.9rem

  .measurementLabel
    margin-top: 0px;
    padding-left: 4px;
    padding-right: 10px;
    padding-bottom: 1px;
    overflow: hidden;
    text-overflow: ellipsis;
    overflow-wrap: normal;
    white-space: nowrap;

  .measurementDisplayText
    display: inline-block;
    padding-left: 9px;
    margin-left: -7px;
    border-left: 1px solid var(--text-secondary-color);
    color: var(--text-primary-color);

  .seriesTagMeaning
    margin-left: 10px;

  // The custom color indicator before the value: the segment row's color dot (h-2 w-2 at the
  // panel's 0.3rem spacing) and its gap to the text, centred on the value line by eye in the
  // browser. With a text color, its left half is the line color and its right half the text color.
  .measurementColorIndicator
    display: inline-flex;
    overflow: hidden;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    margin-left: 2px;
    margin-right: 0.5rem;
    vertical-align: middle;
    position: relative;
    top: -2.25px;

    .measurementColorIndicatorLine,
    .measurementColorIndicatorText
      flex: 1 1 0;
      height: 100%;

  // The value after the dot has no divider: the dot sets it apart, as on a segment row
  .measurementColorIndicator + .measurementDisplayText
    padding-left: 0;
    margin-left: 0;
    border-left: 0;

  .itemIndex
    -webkit-box-sizing: initial;
    -moz-box-sizing: initial;
    box-sizing: initial;

  // An out-of-plane measurement: the index cell in the panel's blue, a cube under the number, and
  // a divider beside it
  &.isOutOfPlane
    .itemIndex
      opacity: 1
      background-color: #1d3a57;
      color: #d5e6f6;
      border-right: 2px solid #3f8fd0;

    .outOfPlaneIcon
      display: block;
      margin: 6px auto 0;

      svg
        width: 20px;
        height: 20px;
        stroke: #9fd0f7;

  &.hasWarnings
    .itemIndex
      opacity: 1
      background-color: #e29e4a;
      color: #fff;

    .warning-icon
      display: block;
      margin: 7px auto 0;

      svg
        width: 22px;
        height: 20px;
        pointer-events: inherit;

.icons
  display: flex;
  align-items: center;
  border-radius: 5px;

.icons .eye-icon
  margin-left: 100px;
  margin-right: -5px;
.icons .angle-double-down
.icons .angle-double-up
  margin-left: 15px;
  margin-right: -5px;

.referenceMeta
  display: flex;
  align-items: center;
  column-gap: 10px;
  margin: 1px 0 0 4px;
  // Room above and below the reference line, between the value line and the label line
  padding: 2px 0;
  color: var(--text-secondary-color);

  // Matches the thumbnail's series/image indicators
  .refItem
    display: inline-flex;
    align-items: center;

  .refLabel
    font-size: 10px;
    font-weight: 900;
    line-height: 1;

  .refValue
    font-size: 12px;
    line-height: 1;
    margin-left: 4px;

&.active
  .referenceMeta
    color: var(--active-color);

.measurementLabelTooltip
  max-width: 320px;
  white-space: normal;
  overflow-wrap: anywhere;

// The icon of the tool that drew the measurement, leading the value (the toolbar button's icon) in
// the out-of-plane cube's blue, 7px before what follows. It replaces the divider before the value.
// Focusable when it opens the measurement's detail card.
.measurementItem .measurementToolIcon
  display: inline-flex
  align-items: center
  justify-content: center
  flex: 0 0 auto
  width: 18px
  height: 18px
  margin-right: 7px
  color: #9fd0f7
  vertical-align: middle
  position: relative
  top: -2px
  border-radius: 3px
  outline: none

  &:focus-visible
    box-shadow: 0 0 0 1px #3f8fd0

  svg
    width: 18px
    height: 18px

.measurementItem .measurementToolIcon + .measurementDisplayText,
.measurementItem .measurementToolIcon + .measurementColorIndicator + .measurementDisplayText,
.measurementItem .measurementDisplayText.hasToolIcon
  padding-left: 0
  margin-left: 0
  border-left: 0

.measurementItem .measurementToolIcon + .measurementColorIndicator
  margin-left: 0

// The reference line's +N: how many values the detail card holds beyond the one on the value line,
// right-aligned under the row controls. A hint, not a control.
.measurementItem .referenceMeta
  margin-right: 10px

  .refMore
    margin-left: auto
    font-size: 10px
    font-weight: 700
    line-height: 14px
    color: #9fd0f7
    border: 1px solid var(--ui-border-color)
    border-radius: 9px
    padding: 0 6px

.measurementItem:hover .referenceMeta .refMore,
.measurementItem.selected .referenceMeta .refMore
  background-color: #1d3a57
  border-color: #3f8fd0

// The shell shared by the Annotations panel's hover cards (the measurement detail card and the
// series card), portalled to the body. The surface is the group header's (the Segmentations
// panel's header) and the border its popovers'; the class is doubled to outrank the ui-next
// popover and tooltip utilities. Fills, chips and notes inside the cards use the out-of-plane
// index cell's blue family (#1d3a57, #3f8fd0, #9fd0f7), so no other grays are introduced.
.annotationHoverCard.annotationHoverCard
  padding: 0
  border: 1px solid var(--ui-border-color)
  border-radius: 10px
  background-color: var(--ui-gray-dark)
  box-shadow: 0 14px 36px rgba(0, 0, 0, 0.6)
  color: var(--text-primary-color)
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif
  z-index: 1060

// The measurement detail card, beside its row
.measurementDetailCard.measurementDetailCard
  width: 320px
  max-height: calc(100vh - 16px)
  overflow-y: auto

  .detailHeader
    display: flex
    gap: 12px
    align-items: center
    padding: 14px 16px 10px

  .detailTile
    display: flex
    align-items: center
    justify-content: center
    flex: 0 0 auto
    width: 40px
    height: 40px
    // Centred on the title block, the tile sits below the cap line of the tool name: lift it
    // so its top edge is level with the heading text
    position: relative
    top: -6px
    border-radius: 9px
    background-color: #1d3a57
    color: #9fd0f7

    svg
      width: 24px
      height: 24px

  .detailName
    font-size: 15px
    font-weight: 600
    color: var(--text-primary-color)

  .detailDescriptor
    font-size: 12px
    color: var(--text-secondary-color)
    margin-top: 1px

  .detailChips
    margin-left: auto
    display: flex
    gap: 6px
    align-items: center
    align-self: flex-start

  .detailChip
    display: inline-flex
    gap: 4px
    align-items: center
    font-size: 10.5px
    font-weight: 700
    line-height: 16px
    padding: 1px 7px
    border-radius: 9px
    color: var(--text-primary-color)
    border: 1px solid var(--ui-border-color)
    white-space: nowrap

    &.isPending
      color: #9fd0f7
      background-color: #1d3a57
      border-color: #3f8fd0

  .detailChipLock
    width: 11px
    height: 11px

  .detailPrimary
    display: flex
    align-items: baseline
    gap: 8px
    padding: 0 16px 12px
    font-size: 28px
    font-weight: 600
    color: var(--text-primary-color)
    font-variant-numeric: tabular-nums
    overflow-wrap: anywhere

    small
      font-size: 12px
      font-weight: 500
      color: var(--text-secondary-color)

  .detailSection
    border-top: 1px solid var(--ui-gray)
    padding: 10px 16px

  .detailSectionHeader
    display: flex
    justify-content: space-between
    margin-bottom: 5px
    font-size: 10px
    font-weight: 800
    letter-spacing: 0.07em
    text-transform: uppercase
    color: var(--text-secondary-color)

    span
      font-weight: 600
      letter-spacing: 0
      text-transform: none

  .detailValue
    display: grid
    grid-template-columns: 1fr auto 24px
    align-items: center
    column-gap: 8px
    height: 26px
    font-size: 13px

    .detailNumber
      color: var(--text-primary-color)
      font-variant-numeric: tabular-nums

  .detailLabel
    color: var(--text-secondary-color)

  .detailToggle
    display: inline-flex
    align-items: center
    justify-content: center
    width: 24px
    height: 24px
    padding: 0
    border: 0
    background: transparent
    color: var(--ui-sky-blue)
    cursor: pointer
    appearance: none

    &.isOff
      color: #56697b

    &:disabled
      cursor: default
      opacity: 0.5

    &:focus-visible
      outline: 1px solid #3f8fd0
      border-radius: 3px

  .detailPin
    justify-self: center
    width: 6px
    height: 6px
    border-radius: 50%
    background-color: var(--ui-sky-blue)

  .detailRef
    display: grid
    grid-template-columns: 78px 1fr
    font-size: 12.5px
    line-height: 20px

    .detailRefValue
      overflow-wrap: anywhere

  .detailSwatch
    display: inline-block
    width: 10px
    height: 10px
    border-radius: 50%
    margin-right: 6px
    vertical-align: -1px

  .detailNote
    margin-top: 8px
    padding: 7px 9px
    border-radius: 6px
    background-color: #1d3a57
    color: #9fd0f7
    font-size: 12px
    line-height: 17px

// Text for assistive technology only
.visuallyHidden
  position: absolute
  width: 1px
  height: 1px
  padding: 0
  margin: -1px
  overflow: hidden
  clip: rect(0, 0, 0, 0)
  white-space: nowrap
  border: 0

// A landmark set's row: its name takes up to two lines; the count pill on the reference line turns
// into the current landmark's position; a held set's index cell has the out-of-plane blue with a
// ring struck through, and its reference line a "Not shown" chip in place of the modality.
.measurementItem .landmarkSetValue
  display: flex
  align-items: flex-start
  min-width: 0

  .measurementToolIcon
    top: 3px

  .measurementColorIndicator
    flex: 0 0 auto
    top: 7px

.measurementItem .landmarkSetName
  display: -webkit-box
  -webkit-box-orient: vertical
  -webkit-line-clamp: 2
  overflow: hidden
  overflow-wrap: anywhere
  min-width: 0
  padding-left: 0
  margin-left: 0
  border-left: 0

  &.isUnnamed
    color: var(--text-secondary-color)

.measurementItem .referenceMeta .refLandmarkCount,
.measurementItem .referenceMeta .landmarkNotShown
  font-size: 10px
  font-weight: 700
  line-height: 14px
  color: #9fd0f7
  border: 1px solid var(--ui-border-color)
  border-radius: 9px
  padding: 0 6px

.measurementItem .referenceMeta .refLandmarkCount
  margin-left: auto

.measurementItem .referenceMeta .landmarkNotShown,
.measurementItem:hover .referenceMeta .refLandmarkCount,
.measurementItem.selected .referenceMeta .refLandmarkCount,
.measurementItem .referenceMeta .refLandmarkCount.isPosition
  background-color: #1d3a57
  border-color: #3f8fd0

.measurementItem.isHeldLandmarkSet .landmarkHeldMark
  display: block
  margin: 6px auto 0
  color: #9fd0f7

  svg
    width: 17px
    height: 17px

.measurementItem .landmarkMatches
  .landmarkMatchesLabel
    color: var(--text-primary-color)

// The line under a set that holds the current landmark, docked in the row card as the row's actions
// are: the marker, the name (clipped, whole on hover) or the type, and the control that clears it
.measurementItem .landmarkCurrent
  display: flex
  align-items: center
  gap: 7px
  height: 28px
  margin-top: 5px
  margin-left: -6px
  padding-left: 3px
  padding-right: 4px
  background-color: var(--ui-gray-darker)
  font-size: 12.5px
  color: var(--text-primary-color)
  white-space: nowrap
  overflow: hidden

  .landmarkShape
    flex: 0 0 auto

  .landmarkCurrentName
    flex: 1 1 auto
    min-width: 0
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap

  .landmarkCurrentClear
    margin-left: auto
    display: inline-flex
    align-items: center
    justify-content: center
    flex: 0 0 auto
    width: 22px
    height: 22px
    padding: 0
    border: 0
    border-radius: 4px
    background: transparent
    color: var(--text-secondary-color)
    cursor: pointer
    appearance: none

    &:hover,
    &:focus-visible
      color: var(--text-primary-color)
      background-color: var(--ui-gray)
      outline: none

// An unnamed landmark's type: an outlined mark, as the count pill, so that it never reads as a name
.landmarkTypeMark
  font-size: 10px
  font-weight: 700
  line-height: 15px
  padding: 0 6px
  border-radius: 8px
  border: 1px solid var(--ui-border-color)
  color: var(--text-primary-color)

// A landmark set's card (the measurement detail card's shell and sections)
.measurementDetailCard .landmarkSetCardBody
  .detailName.isUnnamed
    color: var(--text-secondary-color)

  .landmarkSetDescription
    padding: 2px 16px 10px
    font-size: 12.5px
    line-height: 17px
    overflow-wrap: anywhere

  .landmarkEntries
    display: flex
    flex-direction: column
    margin: 0 -8px

    // Eight entries show; the list scrolls beyond that (LandmarkSetCard sets the height of the first
    // eight as laid out; this is the height of eight one-line entries until it does)
    &.isScrolling
      max-height: 8 * 28px
      overflow-y: auto
      // The list scrolls on its own: its end does not hand the wheel on to the card or the panel
      overscroll-behavior: contain

  .landmarkEntry
    flex: 0 0 auto
    display: grid
    grid-template-columns: 16px 16px minmax(0, 1fr) auto
    column-gap: 7px
    align-items: start
    padding: 5px 8px
    border: 0
    border-radius: 6px
    background: transparent
    color: var(--text-primary-color)
    font: inherit
    font-size: 13px
    line-height: 18px
    text-align: left
    appearance: none

  button.landmarkEntry
    cursor: pointer

    &:hover,
    &:focus-visible
      background-color: var(--ui-gray)
      outline: none

      .landmarkEntryText
        text-decoration: underline

  .landmarkEntry.isCurrent
    background-color: #1d3a57

  .landmarkEntryOrdinal
    font-size: 11px
    color: var(--text-secondary-color)
    text-align: right
    font-variant-numeric: tabular-nums

  .landmarkEntryShape,
  .landmarkEntryColor
    display: inline-flex
    align-items: center
    justify-content: center
    height: 18px

  .landmarkEntryName
    min-width: 0
    overflow-wrap: anywhere

  .landmarkEntryDetail
    display: block
    font-size: 12px
    line-height: 16px
    color: var(--text-secondary-color)

  .landmarkEntriesFooter
    margin-top: 7px
    font-size: 12px
    line-height: 17px
    color: var(--text-secondary-color)

  // The landmark count and its breakdown by type: boxes of one line height centred on it, so the count
  // and each type (its shape, then its text) share a centreline; the breakdown wraps under itself
  .landmarkCountLine
    display: flex
    align-items: flex-start
    column-gap: 10px

  .landmarkCount,
  .landmarkType
    display: inline-flex
    align-items: center
    height: 20px

  .landmarkTypes
    display: flex
    flex-wrap: wrap
    column-gap: 10px

  .landmarkType
    gap: 4px
    white-space: nowrap

    svg
      flex: 0 0 auto

// A landmark's own colour: one colour for Line, split for Line and Text, the left half empty for Text
.landmarkOwnColor
  display: inline-block
  width: 9px
  height: 9px
  border-radius: 50%
  box-sizing: border-box

  &.isTextOnly
    border: 1px solid

// The hover of an application document's lock: a document, then where the row comes from
.measurementApplicationDocumentNote
  display: inline-flex
  align-items: center
  gap: 6px

  .measurementDocumentIcon
    flex: 0 0 auto

// The Category label of a landmark set's card, which has a hover saying what it is
.landmarkCategoryLabel
  cursor: help
  text-decoration: underline dotted
  text-underline-offset: 3px
  outline: none

  &:focus-visible
    box-shadow: 0 0 0 1px #3f8fd0
    border-radius: 2px

.landmarkCategoryHelp.landmarkCategoryHelp
  max-width: 260px
  line-height: 1.4

// A hover inside a landmark set's card is drawn above the card (.annotationHoverCard, 1060)
.landmarkCardTooltip.landmarkCardTooltip
  z-index: 1070

