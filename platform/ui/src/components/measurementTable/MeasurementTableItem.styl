.measurementItem
  .item-color-section
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;

 .item-color
    margin-top: 8px;
    border-radius: 100%;
    width: 20px;
    height: 20px;

  .rowActions
    display: flex
    justify-content: space-between
    align-items: center
    width: auto;
    margin-top: 5px;
    margin-left: -6px;
    padding-left: 3px;
    padding-right: 10px;      
    background-color: var(--ui-gray-darker)
    height: 0
    overflow: hidden
    transition: all 0.3s ease
    visibility: hidden

    .btnAction
      background-color: transparent;
      border: none;
      color: var(--default-color)
      cursor: pointer
      line-height: 35px
      height: 35px
      transition: all 0.3s ease
      white-space: no-wrap

      &:hover, &:active
        color: var(--text-primary-color)

      i
        margin-right: 4px;

  &.selected
    .rowActions
      height: auto;
      visibility: visible

  .measurementContent
    display: flex
    justify-content: space-between;
    width: auto;
    max-width: calc(100% - 10px);

  .measurementLabel
    margin-top: 0px;
    padding-left: 4px;
    padding-right: 10px;
    padding-bottom: 1px;
    overflow: hidden;
    text-overflow: ellipsis;
    overflow-wrap: normal;
    white-space: nowrap;

  .measurementDisplayText
    display: inline-block;
    padding-left: 9px;
    margin-left: -7px;
    border-left: 1px solid var(--text-secondary-color);
    color: var(--text-primary-color);

  .seriesTagMeaning
    margin-left: 10px;

  .itemIndex
    -webkit-box-sizing: initial;
    -moz-box-sizing: initial;
    box-sizing: initial;

  &.hasWarnings
    .itemIndex
      opacity: 1
      background-color: #e29e4a;
      color: #fff;

    .warning-icon
      display: block;
      margin: 7px auto 0;

      svg
        width: 22px;
        height: 20px;
        pointer-events: inherit;

.icons
  display: flex;
  align-items: center;
  border-radius: 5px;

.displayIcon
  margin-right: 8px;

.icons .eye-icon
  margin-left: 100px;
  margin-right: -5px;
.icons .angle-double-down
.icons .angle-double-up
  margin-left: 15px;
  margin-right: -5px;

.referenceMeta
  display: flex;
  align-items: center;
  column-gap: 10px;
  margin: 0 0 6px 4px;
  color: var(--text-secondary-color);

  // Matches the thumbnail's series/image indicators
  .refItem
    display: inline-flex;
    align-items: center;

  .refLabel
    font-size: 10px;
    font-weight: 900;
    line-height: 1;

  .refValue
    font-size: 12px;
    line-height: 1;
    margin-left: 4px;

&.active
  .referenceMeta
    color: var(--active-color);

.measurementLabelTooltip
  max-width: 320px;
  white-space: normal;
  overflow-wrap: anywhere;
