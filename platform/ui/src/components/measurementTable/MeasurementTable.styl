.measurementTable
  background-color: var(--primary-background-color)
  height: 100%
  width: 100%
  display: flex
  flex-direction: column

  .maxMeasurements
    border-radius: 3px
    color: var(--primary-background-color)
    font-size: 12px
    font-weight: 500
    height: 19px
    line-height: 17px
    margin-top: 22px
    margin-right: 15px
    padding: 2px 6px 0
    text-transform: uppercase
    transition: all 0.3s ease
    background-color: var(--default-color)

  .measurementTableHeader
    padding-left: 35px

    .measurementTableHeaderItem
      display: inline-block
      margin-top: 9px
      margin-left: 9px
      padding-left: 9px      
      font-size: 14px
      line-height: 20px
      border-left: 1px solid var(--text-secondary-color)
      color: var(--text-primary-color)

      .timepointLabel
        color: var(--text-secondary-color)
        font-size: 12px

    .warning-status
      display: block
      position: absolute
      width: 50px
      height: 40px
      padding-left: 7px
      left: 15px
      top: 7px

      .warning-border
        display: block
        border: 2px solid #e29e4a
        border-radius: 36px
        padding: 6px 7px
        width: 40px
        height: 40px

      svg
        color: #e29e4a
        width: 22px
        height: 20px
        pointer-events: inherit

  // The Annotations section: the ui-next accordion (PanelSection) fills the space between the
  // header and the footer, and the groups scroll inside it. The markup down to the ScrollArea is
  // accordion root > item > (h3 > button trigger) + [role=region] content > the Accordion
  // content's inner div > PanelSection.Content's wrapper div > ScrollArea; every level along the
  // way is a flex column with no minimum height, so the scroll area gets the remaining height
  // instead of growing (and being clipped) with its rows.
  .measurementTableAnnotations
    flex: 1 1 auto
    min-height: 0
    display: flex
    flex-direction: column

    // Child combinators keep the chain to the Annotations accordion; the groups nested inside it
    // are accordions too and must keep their natural height
    > div, > div > div, > div > div > [role="region"], > div > div > [role="region"] > div, > div > div > [role="region"] > div > div
      flex: 1 1 auto
      min-height: 0
      display: flex
      flex-direction: column

    // The section header reads as the Segmentations panel's "Segmentation Editor" header: the
    // same type, size and weight, with room above it and the groups close beneath it
    > div > div > h3
      margin: 14px 0 0
      flex: 0 0 auto

      // The trigger is a bare button: no preflight in the viewer, so its chrome is reset here,
      // and it takes the surface the Segmentations panel gives its section header
      button
        appearance: none
        border: 0
        font: inherit
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif
        height: 63px
        margin: 0 0 -6px
        color: var(--text-secondary-color)
        background-color: var(--ui-gray-darker)

        span
          font-size: 22px
          font-weight: 300
          line-height: 63px
          padding: 0 10px 0 3px

    .measurementTableScroll
      flex: 1 1 auto
      min-height: 0

    // The accordion content sets Tailwind's text-base (16px); rows use the page's 14px text
    .tableList
      font-size: 14px
      line-height: 1.42857143

    .measurementGroups
      h3
        margin: 0

      .measurementGroupHeader
        appearance: none
        display: flex
        width: 100%
        overflow: hidden
        border-style: solid
        border-color: var(--primary-background-color)
        border-width: 3px 0 2px
        font: inherit
        text-align: left
        cursor: pointer

        .tableListHeaderTitle
          flex: 1
          max-width: none

      .measurementGroupToggle
        display: flex
        align-items: center
        padding-right: 10px
        color: #FFFFFF

        // The Plus icon has a fixed stroke color
        svg
          width: 20px
          height: 20px

          [stroke]:not([stroke="none"])
            stroke: currentColor

      .measurementGroupHeader[data-state="open"] .measurementGroupExpand,
      .measurementGroupHeader[data-state="closed"] .measurementGroupCollapse
        display: none

    // The groups (Measurements, Findings) are subsections of Annotations: their header row reads
    // as the Segmentation Editor's segmentation header (the row with the segmentation's name):
    // the same surface, vertical padding, type size and weight; the count keeps its blue
    .tableListHeader
      height: auto
      line-height: 24px
      margin-top: 0
      padding: 0.5rem 0
      background-color: var(--ui-gray-dark)
      align-items: center
      border-top-width: 3px
      border-bottom-width: 2px

      .tableListHeaderTitle
        color: var(--text-primary-color)
        font-size: 16px
        font-weight: 400
        line-height: 24px
        padding: 0 10px 0 14px

      .numberOfItems
        color: var(--ui-sky-blue)
        font-size: 16px
        font-weight: 400
        height: auto
        line-height: 24px
        max-width: none
        padding-right: 12px
        text-align: right

  .measurementTableFooter
    padding: 10px
    color: #fff
    text-align: center
    z-index: 1

    .saveBtn
      border: 1px solid var(--ui-border-color-active)
      border-radius: 25px
      background-color: var(--active-color)
      color: var(--ui-gray-dark)
      line-height: 25px
      padding: 0 20px
      outline: none
      cursor: pointer

      &:hover, &:active
        background-color: var(--ui-sky-blue)

      svg
        margin-right: 4px
        position: relative
        top: 2px

.tooltip-warning
  &.in
    opacity 1

  .tooltip-inner
    padding: 0

    .warningTitle
      text-align: left
      background-color: var(--ui-gray-darkest)
      padding: 7px 15px
      border-top-left-radius: 7px
      border-top-right-radius: 7px

    .warningContent
      text-align center
      background-color: var(--ui-gray)
      border-bottom-left-radius: 7px
      border-bottom-right-radius: 7px

      ol
        margin-top: auto
        padding-inline-start: 20px
        padding-top: 10px
        padding-bottom: 10px
        padding-left: 25px
        text-align: left

        li
          padding-right: 10px
